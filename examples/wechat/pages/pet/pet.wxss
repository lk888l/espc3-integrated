page { padding: 36rpx; color: #152921; background: #f4f5ee; }
label, text { display: block; margin: 24rpx 0; }
input, button { margin: 12rpx 0; padding: 12rpx; background: white; }
.choices { display: flex; flex-wrap: wrap; }
.choices button { width: auto; margin: 6rpx 10rpx 6rpx 0; padding: 8rpx 22rpx; }
.choices .selected { color: white; background: #152921; }
